{
	"name": "DF_EnRich_Orders",
	"properties": {
		"description": "Enrich Orders ",
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Fact_Orders",
						"type": "DatasetReference"
					},
					"name": "RawSource"
				},
				{
					"dataset": {
						"referenceName": "DS_DimCustomer",
						"type": "DatasetReference"
					},
					"name": "Customers"
				},
				{
					"dataset": {
						"referenceName": "DS_DimProduct",
						"type": "DatasetReference"
					},
					"name": "Products"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Fact_Orders",
						"type": "DatasetReference"
					},
					"name": "FinalDestination"
				}
			],
			"transformations": [
				{
					"name": "OrdersWithCustomer"
				},
				{
					"name": "EnrichProducts"
				},
				{
					"name": "WithProfit"
				},
				{
					"name": "FinalEnriched"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Orderid as string,",
				"          CustomerId as string,",
				"          Productid as string,",
				"          Customername as string,",
				"          Productname as string,",
				"          Cetagory as string,",
				"          Orderdate as date,",
				"          Ordermonth as integer,",
				"          OrderYear as integer,",
				"          Quentity as integer,",
				"          UnitPrice as decimal(10,2),",
				"          Discountpct as decimal(10,2),",
				"          Discountamount as decimal(10,2),",
				"          GrossRevenue as decimal(10,2),",
				"          ShippingCost as decimal(10,2),",
				"          Netrevenue as decimal(10,2),",
				"          CostofGoods as decimal(10,2),",
				"          GrossProfit as decimal(10,2),",
				"          PaymentMethord as string,",
				"          Orderstatus as string,",
				"          Isdelivered as boolean,",
				"          Region as string,",
				"          LoadAt as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> RawSource",
				"source(output(",
				"          Customerid as string,",
				"          Fullname as string,",
				"          Email as string,",
				"          City as string,",
				"          State as string,",
				"          Country as string,",
				"          Customersegment as string,",
				"          Joindate as date,",
				"          Loaddate as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Customers",
				"source(output(",
				"          productId as string,",
				"          ProductName as string,",
				"          Category as string,",
				"          Subcatogery as string,",
				"          Brand as string,",
				"          UnitPrice as decimal(10,2),",
				"          CostPrice as decimal(10,2),",
				"          Supplier as string,",
				"          Isactive as boolean,",
				"          Loadat as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Products",
				"RawSource, Customers join(RawSource@CustomerId == Customers@Customerid,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> OrdersWithCustomer",
				"OrdersWithCustomer, Products join(RawSource@Productid == Products@productId,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> EnrichProducts",
				"EnrichProducts derive(CostOfGoods = Quentity*CostPrice,",
				"          GrossProfit = Netrevenue-(Quentity*CostPrice),",
				"          ProfitMarginPct = (Netrevenue-Quentity*CostPrice)/iif(Netrevenue==toDecimal(0),toDecimal(1),Netrevenue)*100) ~> WithProfit",
				"WithProfit select(mapColumn(",
				"          Orderid,",
				"          CustomerId = RawSource@CustomerId,",
				"          Productid = RawSource@Productid,",
				"          Fullname,",
				"          Productname = RawSource@Productname,",
				"          Cetagory,",
				"          Orderdate,",
				"          Ordermonth,",
				"          OrderYear,",
				"          Quentity,",
				"          UnitPrice = RawSource@UnitPrice,",
				"          Discountpct,",
				"          Discountamount,",
				"          GrossRevenue,",
				"          ShippingCost,",
				"          Netrevenue,",
				"          CostofGoods = RawSource@CostofGoods,",
				"          GrossProfit,",
				"          PaymentMethord,",
				"          Orderstatus,",
				"          Isdelivered,",
				"          Region,",
				"          Customerid = Customers@Customerid,",
				"          Fullname,",
				"          Email,",
				"          City,",
				"          State,",
				"          Country,",
				"          Customersegment,",
				"          Joindate,",
				"          Loaddate,",
				"          productId = Products@productId,",
				"          ProductName = Products@ProductName,",
				"          Category,",
				"          Subcatogery,",
				"          Brand,",
				"          UnitPrice = Products@UnitPrice,",
				"          CostPrice,",
				"          Supplier,",
				"          Isactive,",
				"          Loadat = Products@Loadat,",
				"          CostOfGoods = WithProfit@CostOfGoods,",
				"          ProfitMarginPct",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> FinalEnriched",
				"FinalEnriched sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Orderid as string,",
				"          CustomerId as string,",
				"          Productid as string,",
				"          Customername as string,",
				"          Productname as string,",
				"          Cetagory as string,",
				"          Orderdate as date,",
				"          Ordermonth as integer,",
				"          OrderYear as integer,",
				"          Quentity as integer,",
				"          UnitPrice as decimal(10,2),",
				"          Discountpct as decimal(10,2),",
				"          Discountamount as decimal(10,2),",
				"          GrossRevenue as decimal(10,2),",
				"          ShippingCost as decimal(10,2),",
				"          Netrevenue as decimal(10,2),",
				"          CostofGoods as decimal(10,2),",
				"          GrossProfit as decimal(10,2),",
				"          PaymentMethord as string,",
				"          Orderstatus as string,",
				"          Isdelivered as boolean,",
				"          Region as string,",
				"          LoadAt as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          Orderid,",
				"          Customername = Fullname,",
				"          CostofGoods = FinalEnriched@CostofGoods,",
				"          Cetagory,",
				"          Orderdate,",
				"          Ordermonth,",
				"          OrderYear,",
				"          Quentity,",
				"          UnitPrice,",
				"          Discountpct,",
				"          Discountamount,",
				"          GrossRevenue,",
				"          ShippingCost,",
				"          Netrevenue,",
				"          GrossProfit,",
				"          PaymentMethord,",
				"          Orderstatus,",
				"          Isdelivered,",
				"          Region,",
				"          Productname = FinalEnriched@Productname",
				"     )) ~> FinalDestination"
			]
		}
	}
}